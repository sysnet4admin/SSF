server {
    listen 80;

    # 정적 파일 서빙 (React 빌드 결과)
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # /api 요청은 백엔드 Service(backend-service, ClusterIP)로 프록시합니다.
    # 주소를 변수로 두고 resolver로 요청 시점에 해석하므로,
    # backend가 아직 없어도 nginx는 정상 기동하고 해당 요청만 실패합니다.
    # ${NAMESERVER}는 컨테이너 시작 시 /etc/resolv.conf에서 채워집니다.
    location /api {
        resolver ${NAMESERVER} valid=10s;
        set $backend_upstream http://backend-service:8080;
        proxy_pass $backend_upstream;
    }
}
